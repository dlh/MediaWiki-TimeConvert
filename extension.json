{
	"name": "TimeConvert",
	"version": "1.0.0",
	"author": "dlh",
	"url": "https://github.com/dlh/MediaWiki-TimeConvert",
	"descriptionmsg": "timeconvert-desc",
	"license-name": "MIT",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"MessagesDirs": {
		"TimeConvert": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"TimeConvertMagic": "TimeConvert.magic.php"
	},
	"config": {
		"TimeConvertTimetableMaxRows": {
			"value": 20,
			"description": "Maximum number of rows allowed in a timetable parser function."
		},
		"TimeConvertTimetableMaxZones": {
			"value": 10,
			"description": "Maximum number of output time zones allowed in a timetable parser function."
		},
		"TimeConvertTimetableMaxFormatLength": {
			"value": 100,
			"description": "Maximum length of the output format string allowed in a timetable parser function."
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\TimeConvert\\": "src/"
	},
	"Hooks": {
		"ParserFirstCallInit": "main",
		"ScribuntoExternalLibraries": "scribunto"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\TimeConvert\\Hooks"
		},
		"scribunto": {
			"class": "MediaWiki\\Extension\\TimeConvert\\ScribuntoHooks"
		}
	},
	"manifest_version": 2
}
